import camion.*
import cosas.*

describe "test paquete, bateria, contenedor y embalaje" {

  test "el contenedor pesa 960 si le metemos embalaje, bumblebee y residuos de 30kg" {
    residuos.peso(30)
    embalaje.cambiarLoQueEnvuelve(residuos)
    contenedor.meterElementos([embalaje, residuos, bumblebee])
    assert.equals(30+30+800+100, contenedor.peso())
  }

  test "test peso" {
    bumblebee.cambiarForma(robot)
    arena.peso(150)
    bateria.cargarYDescargarMisiles()
    paqueteDeLadrillos(80)
    embalaje.cambiarLoQueEnvuelve(paqueteDeLadrillos)
    camion.cargarCosa([bumblebee, arena, bateria, embalaje])
    //bumblebee = 800
    //arena = 150
    //bateria = 300
    //embalaje = 160
    assert.equals(1000+800+150+300+160, camion.peso())
  }

}